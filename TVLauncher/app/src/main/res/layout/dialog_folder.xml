<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="880dp"
    android:layout_height="560dp"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="32dp">

    <!-- Header: Folder Name & Operation Buttons -->
    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_white"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="影视播放"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFolderAppCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_dim"
        android:textSize="16sp"
        tools:text="共 6 个应用"
        app:layout_constraintBottom_toBottomOf="@id/tvFolderName"
        app:layout_constraintStart_toEndOf="@id/tvFolderName"
        app:layout_constraintTop_toTopOf="@id/tvFolderName" />

    <!-- Action Buttons for Folder -->
    <LinearLayout
        android:id="@+id/folderActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Add App Button -->
        <LinearLayout
            android:id="@+id/btnAddApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_btn"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="添加应用"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rename Button -->
        <LinearLayout
            android:id="@+id/btnRenameFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_status_btn"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_edit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="重命名"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Delete Folder Button -->
        <LinearLayout
            android:id="@+id/btnDeleteFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_status_btn"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="解散"
                android:textColor="@color/red_danger"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Apps in Folder RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolderApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:focusable="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/tvFolderHint"
        app:layout_constraintTop_toBottomOf="@id/tvFolderName" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="文件夹内暂无应用，请点击右上角【添加应用】"
        android:textColor="@color/text_dim"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tvFolderHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFolderName" />

    <!-- Bottom Hint -->
    <TextView
        android:id="@+id/tvFolderHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="按遥控器【OK】启动应用  按【菜单键】移出此应用  按【返回键】退出文件夹"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
