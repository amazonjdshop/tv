<?xml version="1.0" encoding="utf-8"?>
<com.hm.tvlauncher.ui.view.TVFocusCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardView"
    android:layout_width="160dp"
    android:layout_height="180dp"
    android:layout_margin="12dp"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Add App or Folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_to_home"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</com.hm.tvlauncher.ui.view.TVFocusCardView>
