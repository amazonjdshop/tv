<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="880dp"
    android:layout_height="480dp"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="32dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvWeatherTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather_detail_title"
        android:textColor="@color/text_white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWeatherCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/accent"
        android:textSize="18sp"
        tools:text="当前城市: 深圳"
        app:layout_constraintBottom_toBottomOf="@id/tvWeatherTitle"
        app:layout_constraintStart_toEndOf="@id/tvWeatherTitle"
        app:layout_constraintTop_toTopOf="@id/tvWeatherTitle" />

    <!-- Current Weather Overview Card -->
    <LinearLayout
        android:id="@+id/currentWeatherBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_default"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvWeatherTitle">

        <ImageView
            android:id="@+id/ivDetailIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_weather_sunny" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="26°C" />

            <TextView
                android:id="@+id/tvDetailCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                tools:text="晴朗少云" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="48dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="#26FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailHumidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                tools:text="空气湿度: 65%" />

            <TextView
                android:id="@+id/tvDetailWind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                tools:text="当前风速: 3.2 m/s (微风)" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5-Day Forecast Grid -->
    <LinearLayout
        android:id="@+id/llForecastContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnWeatherClose"
        app:layout_constraintTop_toBottomOf="@id/currentWeatherBox" />

    <Button
        android:id="@+id/btnWeatherClose"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_status_btn"
        android:text="关闭"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
